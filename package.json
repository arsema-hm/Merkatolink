{
  "name": "merkatolink",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "install:all": "corepack pnpm install",
    "dev": "corepack pnpm --parallel --filter @merkatolink/web --filter @merkatolink/api dev",
    "test": "corepack pnpm -r test",
    "lint": "corepack pnpm -r lint",
    "typecheck": "corepack pnpm -r typecheck",
    "build": "corepack pnpm -r build",
    "db:migrate": "corepack pnpm --filter @merkatolink/db migrate",
    "db:seed": "corepack pnpm --filter @merkatolink/db seed",
    "db:reset": "corepack pnpm --filter @merkatolink/db reset"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "vitest": "^3.2.4",
    "eslint": "^9.25.0",
    "prettier": "^3.5.3"
  }
}
